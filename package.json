{
  "name": "opencode-remote-plugin",
  "version": "0.2.0",
  "description": "OpenCode plugin that runs all sessions on a remote machine over SSH, with automatic git sync back to local branches",
  "main": "./.opencode/plugin/index.js",
  "types": "./.opencode/plugin/index.d.ts",
  "files": [
    ".opencode"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mickeiik/opencode-remote-plugin.git"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/mickeiik/opencode-remote-plugin/issues"
  },
  "homepage": "https://github.com/mickeiik/opencode-remote-plugin#readme",
  "keywords": [
    "opencode",
    "plugin",
    "ssh",
    "remote"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.23",
    "xdg-basedir": "^5.1.0",
    "zod": "^4.2.1"
